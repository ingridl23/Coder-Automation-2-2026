    {
      "parameters": {
        "jsCode": "const raw = $json.text ?? $json.output ?? $json.response ?? '';\nlet d;\ntry {\n  const clean = String(raw).replace(/^```json\\s*/i, '').replace(/```$/, '').trim();\n  d = JSON.parse(clean);\n} catch (e) {\n  d = {\n    intent: 'error_clasificacion',\n    confidence: 0,\n    risk: 'HIGH'\n  };\n}\nreturn [{ json: {\n  original_input: $('When chat message received').first().json.chatInput,\n  intent: d.intent ?? 'error_clasificacion',\n  confidence: d.confidence ?? 0,\n  risk: d.risk ?? 'HIGH'\n} }];"
